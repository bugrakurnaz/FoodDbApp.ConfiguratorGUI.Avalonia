<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:viewModels="clr-namespace:FoodDbApp.ConfiguratorGUI.Avalonia.ViewModels"
             xmlns:views="clr-namespace:FoodDbApp.ConfiguratorGUI.Avalonia.Views"
             xmlns:category="clr-namespace:FoodDbApp.ConfiguratorGUI.Avalonia.ViewModels.Category"
             xmlns:category1="clr-namespace:FoodDbApp.ConfiguratorGUI.Avalonia.Views.Category"
             xmlns:StorageLocation="clr-namespace:FoodDbApp.ConfiguratorGUI.Avalonia.ViewModels.StorageLocations"
             xmlns:storageLocation="clr-namespace:FoodDbApp.ConfiguratorGUI.Avalonia.Views.StorageLocation"
             x:Class="FoodDbApp.ConfiguratorGUI.Avalonia.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.Styles>
        <StyleInclude Source="Styles/AppStyles.axaml" />
        <actipro:ModernTheme />
    </Application.Styles>
    <Application.DataTemplates>
        <DataTemplate x:DataType="viewModels:NavigationBarViewModel">
            <views:NavigationBar />
        </DataTemplate>
        <DataTemplate x:DataType="viewModels:NavigatingContainerViewModel">
            <views:NavigatingContainerView />
        </DataTemplate>
        
        <!-- Category Management-->
        <DataTemplate x:DataType="category:CategoryManagementViewModel">
            <category1:CategoryManagementView />
        </DataTemplate>
        <DataTemplate x:DataType="category:AllCategoriesViewModel">
            <category1:AllCategoriesView />
        </DataTemplate>
        <DataTemplate x:DataType="category:EditCategoryViewModel">
            <category1:EditCategoryView />
        </DataTemplate>
        <DataTemplate x:DataType="category:AddCategoryViewModel">
            <category1:AddCategoryView />
        </DataTemplate>
        
        <!-- Storage Location Management-->
        <DataTemplate x:DataType="StorageLocation:StorageLocationManagementViewModel">
            <storageLocation:StorageLocationManagementView />
        </DataTemplate>
        <DataTemplate x:DataType="StorageLocation:AllStorageLocationsViewModel">
            <storageLocation:AllStorageLocationsView />
        </DataTemplate>
        <DataTemplate x:DataType="StorageLocation:EditStorageLocationViewModel">
            <storageLocation:EditStorageLocationView />
        </DataTemplate>
        <DataTemplate x:DataType="StorageLocation:AddStorageLocationViewModel">
            <storageLocation:AddStorageLocationView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>