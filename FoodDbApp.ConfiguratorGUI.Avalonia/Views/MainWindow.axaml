<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FoodDbApp.ConfiguratorGUI.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:FoodDbApp.ConfiguratorGUI.Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FoodDbApp.ConfiguratorGUI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FoodDbApp Configurator GUI">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel/>
    </Design.DataContext>

    <SplitView PanePlacement="Left"
               IsPaneOpen="True"
               DisplayMode="Inline">
        <SplitView.Pane>
            <ContentControl Content="{Binding NavigationBarViewModel}" />
        </SplitView.Pane>
        <ContentControl Content="{Binding NavigatingContainerViewModel}" />
    </SplitView>
</Window>
