<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:storageLocations="clr-namespace:FoodDbApp.ConfiguratorGUI.Avalonia.ViewModels.StorageLocations"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FoodDbApp.ConfiguratorGUI.Avalonia.Views.StorageLocation.StorageLocationManagementView"
             x:DataType="storageLocations:StorageLocationManagementViewModel">
    <TabControl>
        <TabItem Header="All Storage Locations">
            <ContentControl Content="{Binding AllStorageLocationsViewModel}" />
        </TabItem>
        <TabItem Header="Add Storage Location">
            <ContentControl Content="{Binding AddStorageLocationViewModel}" />
        </TabItem>
    </TabControl>
</UserControl>
