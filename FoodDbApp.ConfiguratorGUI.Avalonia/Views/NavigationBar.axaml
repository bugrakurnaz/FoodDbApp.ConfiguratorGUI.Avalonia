<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FoodDbApp.ConfiguratorGUI.Avalonia.ViewModels"
             xmlns:primitives="clr-namespace:FoodDbApp.ConfiguratorGUI.Avalonia.Primitives"
             xmlns:converters="clr-namespace:FoodDbApp.ConfiguratorGUI.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FoodDbApp.ConfiguratorGUI.Avalonia.Views.NavigationBar"
             x:DataType="viewModels:NavigationBarViewModel">
    <UserControl.Resources>
        <converters:DatabaseItemTypeToStringConverter x:Key="DatabaseItemTypeToStringConverter" />
    </UserControl.Resources>
    <ListBox ItemsSource="{Binding DatabaseItemTypes}"
             SelectedItem="{Binding SelectedDatabaseItemType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="primitives:DatabaseItemType">
                <TextBlock Text="{Binding Path=., 
                    Converter={StaticResource DatabaseItemTypeToStringConverter}}"/>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
